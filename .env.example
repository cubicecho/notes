# Server
PORT=4000
APP_URL=http://localhost:8081
EXPO_PUBLIC_API_URL=http://localhost:4000

# Database (leave unset to use embedded PGLite)
# DATABASE_URL=postgres://user:pass@localhost:5432/notes
PGLITE_DATA_DIR=./pgdata

# Auth — session tokens are JWTs signed with this. Required in production (the
# server refuses to boot without it): openssl rand -hex 32
# JWT_SECRET=

# Skip the magic link entirely: entering an email signs straight in. Secure local
# networks only — anyone who can reach the port can sign in as any address.
# AUTH_MAGIC_LINK=false

# Return the magic link in the login response instead of emailing it. Always on
# in dev. Set to "true" for local / homelab deployments that have no mail
# provider so you can copy the link straight from the login screen. Do NOT
# enable on a public instance — it hands a login link to anyone with an email.
# EXPOSE_MAGIC_LINK=true
